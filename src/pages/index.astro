---
import Base from '../layouts/Base.astro';
import Practical from '../components/Practical.astro';
import EventBlock from '../components/EventBlock.astro';
import Marks from '../components/Marks.astro';
import { getEvents, href, img, fmtShort, fmtLong } from '../lib/util';
import { contact, patrons } from '../data/site';

// Stejný obsah a pořadí jako původní úvodní stránka:
// levý sloupec „připravujeme“, pravý sloupec „proběhlo“.
const { upcoming, past } = await getEvents();
const recent = past.slice(0, 8);
const next = upcoming[0];
---
<Base title="home">
  <section class="banner-band" aria-label="Poznat, pochopit, použít">
    <Marks variant="banner" />
    <div class="container banner-grid">
      <div>
      <h1 class="banner-slogan">Poznat, pochopit, použít&nbsp;…</h1>
      <p class="banner-sub">Franchise Club – klub pro dialog, spolupráci a růst (nejen) ve franchisingu od roku 2006</p>
      {next && (
        <a class="banner-next" href={href(`akce/${next.id}/`)}>
          <span class="bn-label">Příští setkání</span>
          <span class="bn-date">{fmtLong(next.data.date)}, {next.data.start}</span>
          <span class="bn-title">{next.data.title}&nbsp;<span aria-hidden="true">»</span></span>
        </a>
      )}
      </div>
      {patrons[0] && (
        <a class="patron-card" href={patrons[0].url} title={patrons[0].name}>
          <span class="patron-label">Patron klubu</span>
          <img src={img(patrons[0].logo)} alt={patrons[0].name} width="160" height="80" />
        </a>
      )}
    </div>
  </section>

  <div class="container home-cols">
    <section class="col" aria-labelledby="pripravujeme">
      <h2 id="pripravujeme" class="col-title">připravujeme</h2>
      <img class="club-logo" src={img('franchiseclub330x132.gif')} alt="Franchise Club – klub pro dialog a spolupráci ve franchisingu" width="330" height="132" />

      {upcoming.length === 0 && <p>Program další sezóny brzy zveřejníme.</p>}
      {upcoming.map((e) => <EventBlock event={e} />)}

      <article class="ev">
        <p class="ev-label">Nabídka členům klubu na dovolenou nebo teambuilding</p>
        <p class="ev-when">Celoročně ve Villa Dallmayr Eva v Toskánsku (<a href="https://www.villadaeva.it">www.villadaeva.it</a>)</p>
        <a class="ev-img" href="https://www.villadaeva.it"><img src={img('villa-da-eva.jpg')} alt="Villa Dallmayr Eva v Toskánsku" loading="lazy" width="385" height="203" /></a>
      </article>

      {upcoming.length > 0 && (
        <article class="ev">
          <p class="ev-label">Plánované termíny klubových setkání</p>
          <p>Termíny klubů:</p>
          <ul class="arrow">
            {upcoming.map((e) => <li><a href={href(`akce/${e.id}/`)}>{fmtShort(e.data.date)}</a> – {e.data.title}</li>)}
          </ul>
        </article>
      )}

      <article class="ev">
        <h2>Otevíráme hlavy, okysličujeme mozky!</h2>
        <p>Těšíme se na vás a na společně strávený večer. Bude vás to bavit, a ještě se něco dozvíte a potkáte se s novými a zajímavými lidmi.</p>
        <p class="signature">Za tým Franchise Clubu<br /><strong>JAROSLAV TAMCHYNA, prezident Franchise Clubu</strong></p>
        <p>Pokud máte nějaké další otázky nebo potřebujete více informací, neváhejte se na mě obrátit!</p>
      </article>

      <details class="ev m-collapse" open>
        <summary><h2>Praktické informace</h2></summary>
        <Practical />
      </details>

      <details class="ev m-collapse" open>
        <summary><h2>Kontakty</h2></summary>
        <p><strong>Franchise Club</strong> je klub pro dialog, spolupráci a růst (nejen) ve franchisingu, založený v roce 2006 v Praze. Provozovatelem Franchise Clubu je Český institut pro franchising (ČIFRA) – národní centrum pro vzdělávací, popularizační, publikační, poradenskou a vědeckou činnost ve franchisingu.</p>
        <div class="people">
          <div class="person">
            <p class="person-role">prezident klubu</p>
            <p class="person-name">Jaroslav Tamchyna</p>
            <p><a href="tel:+420603578035">+420 603 578 035</a><br /><a href="mailto:tamchyna@ifranchising.cz">tamchyna@ifranchising.cz</a></p>
          </div>
          <div class="person">
            <p class="person-role">tajemnice klubu</p>
            <p class="person-name">Tereza Chábková</p>
            <p><a href="tel:+420603474035">+420 603 474 035</a><br /><a href="mailto:office@ifranchising.cz">office@ifranchising.cz</a></p>
          </div>
        </div>
        <ul class="arrow">
          <li><strong>Kancelář klubu:</strong> {contact.street}, {contact.city}</li>
          <li><strong>Web:</strong> <a href={href()}>www.ifranchising.cz</a></li>
          <li><strong>Facebook:</strong> <a href={contact.facebook}>fb.com/franchiseclub.cz</a></li>
        </ul>
        <p>Franchise Club a Český institut pro franchising jsou členy největší mezinárodní profesní komunity v oblasti franchisingu – <strong>International Franchise Association</strong> (<a href="https://www.franchise.org/">IFA</a>).</p>
      </details>
    </section>

    <section class="col col--past" aria-labelledby="probehlo">
      <h2 id="probehlo" class="col-title">proběhlo</h2>
      {recent.map((e) => <EventBlock event={e} />)}
      <p class="ev-more" style="margin-top:8px"><a class="btn btn--dark" href={href('akce/')}>Všechny proběhlé akce</a></p>
    </section>
  </div>

  <script>
    // Na mobilu sbalit dlouhé bloky, aby „proběhlo“ nebylo na konci nekonečného scrollu.
    if (matchMedia('(max-width: 900px)').matches) {
      document.querySelectorAll<HTMLDetailsElement>('details.m-collapse').forEach((d) => (d.open = false));
    }
  </script>
</Base>
