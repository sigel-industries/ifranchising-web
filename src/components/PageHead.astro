---
import { href } from '../lib/util';
interface Props { title: string; lead?: string; crumbs?: [string, string][] }
const { title, lead, crumbs = [] } = Astro.props;
---
<section class="page-head">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Drobečková navigace">
        <a href={href()}>aktuality</a>
        {crumbs.map(([p, l]) => <> / <a href={href(p)}>{l}</a></>)}
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
