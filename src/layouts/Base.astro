---
import '../styles/global.css';
import { href, img } from '../lib/util';
import { nav, contact, patrons, productPartners, expertPartners, type Partner } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'Aktivní propojení výzkumu, informací a zkušeností s lidmi, kteří franchising tvoří a využívají.',
  image,
} = Astro.props;
const fullTitle = title === 'home' ? 'Franchising: Český institut pro franchising' : `${title} – Český institut pro franchising`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const home = href();
const isCurrent = (p: string) => (p === '' ? path === home || path.startsWith(href('akce/')) : path.startsWith(href(p)));
const link = (p: Partner) => (p.url.startsWith('/') ? href(p.url) : p.url);
const year = new Date().getFullYear();
// Pracovní verze (GitHub Pages): neindexovat, aby nekonkurovala ostrému webu.
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const groups: [string, Partner[]][] = [
  ['Patron klubu', patrons],
  ['Produktoví partneři', productPartners],
  ['Odborní partneři', expertPartners],
];
const office = contact.people[1];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="RNDr. Jaroslav Tamchyna" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#333333" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..800;1,400&display=swap" />
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>

    <div class="topbar">
      <div class="container">
        <span class="slogan">Poznat, pochopit, použít…</span>
        <span class="contacts">
          <a class="hide-sm" href={`tel:${office.phone.replace(/\s/g, '')}`}>{office.phone}</a>
          <a href={`mailto:${office.email}`}>{office.email}</a>
          <span class="flags">
            <a href={home} title="česky"><img src={img('czech-flag.gif')} alt="česky" /></a>
            <a href="http://www.ifranchise.cz" hreflang="en" lang="en" title="English"><img src={img('english-flag.gif')} alt="English" /></a>
          </span>
        </span>
      </div>
    </div>

    <header class="site-header">
      <div class="container">
        <a class="logo" href={home}>
          <img src={img('cesky-institut-franchisingu.gif')} alt="" />
          <span class="wordmark"><b>Český institut pro franchising</b><small>a Franchise Club</small></span>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="hlavni-menu">Menu</button>
        <nav class="menu" id="hlavni-menu" aria-label="Hlavní navigace">
          {nav.map(([p, label]) => (
            <a href={href(p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="obsah">
      <slot />
    </main>

    <section class="partners-strip" aria-label="Patroni a partneři">
      <div class="container groups">
        {groups.map(([t, list]) => (
          <div>
            <h2>{t}</h2>
            <div class="row">
              {list.map((p) => (
                <a href={link(p)} title={p.name}><img src={img(p.logo)} alt={p.name} loading="lazy" /></a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>Český institut pro franchising</h2>
            <p>Národní centrum pro vzdělávací, popularizační, publikační, poradenskou a vědeckou činnost ve franchisingu. Provozovatel Franchise Clubu.</p>
            <p>Člen International Franchise Association (<a href="https://www.franchise.org/">IFA</a>).</p>
          </div>
          <div>
            <h2>Kancelář</h2>
            <p>{contact.org}<br />{contact.street}, {contact.city}</p>
            <p>Tel. <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a><br /><a href={contact.facebook}>Facebook klubu</a></p>
          </div>
          <nav aria-label="Patička">
            <h2>Navigace</h2>
            <ul class="footer-nav">
              {nav.map(([p, label]) => <li><a href={href(p)}>{label}</a></li>)}
              <li><a href={href('akce/')}>všechny akce</a></li>
            </ul>
          </nav>
          <div>
            <h2>Kontakty</h2>
            {contact.people.map((p) => (
              <p>{p.name}<br /><a href={`mailto:${p.email}`}>{p.email}</a><br /><a href={`tel:${p.phone.replace(/\s/g, '')}`}>{p.phone}</a></p>
            ))}
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2006–{year} Český institut pro franchising, s.r.o.</span>
          <a href={href('osobni-udaje/')}>Zásady ochrany osobních údajů</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('hlavni-menu');
      // ukončit skeleton animaci po načtení obrázku
      document.querySelectorAll<HTMLImageElement>('.ev-img img, .past img').forEach((i) => {
        const done = () => i.setAttribute('data-loaded', '');
        i.complete ? done() : i.addEventListener('load', done, { once: true });
      });
      btn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
