---
import '../styles/global.css';
import { href } from '../lib/util';
import { nav, contact } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = 'Franchise Club a Český institut pro franchising – národní centrum pro vzdělávání, poradenství a setkávání ve franchisingu od roku 2006.', image } = Astro.props;
const fullTitle = title === 'home' ? 'Franchise Club – Český institut pro franchising' : `${title} – Franchise Club`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const isCurrent = (p: string) => path.startsWith(href(p));
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#0e3b43" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href()}>
          <b>Franchise Club</b>
          <small>Český institut pro franchising</small>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="hlavni-menu">Menu</button>
        <nav class="nav" id="hlavni-menu" aria-label="Hlavní navigace">
          {nav.map(([p, label]) => (
            <a href={href(p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>
          ))}
          <a class="lang" href="http://www.ifranchise.cz" hreflang="en" lang="en">EN</a>
          <a class="member" href={href('clenska-zona/')} aria-current={isCurrent('clenska-zona/') ? 'page' : undefined}>Členská zóna</a>
        </nav>
      </div>
    </header>

    <main id="obsah">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h2>Franchise Club</h2>
            <p>Klub pro dialog, spolupráci a růst (nejen) ve franchisingu, založený v roce 2006 v Praze. Provozuje ho Český institut pro franchising (ČIFRA).</p>
            <p>Franchise Club a ČIFRA jsou členy International Franchise Association (<a href="https://www.franchise.org/">IFA</a>).</p>
          </div>
          <div>
            <h2>Kancelář</h2>
            <p>{contact.org}<br />{contact.street}, {contact.city}</p>
            <p>Tel. <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></p>
            <p><a href={contact.facebook}>Facebook klubu</a></p>
          </div>
          <div>
            <h2>Lidé</h2>
            {contact.people.map((p) => (
              <p>
                {p.name}<br />
                <a href={`mailto:${p.email}`}>{p.email}</a><br />
                <a href={`tel:${p.phone.replace(/\s/g, '')}`}>{p.phone}</a>
              </p>
            ))}
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2006–{year} {contact.org} IČ {contact.ico}</span>
          <a href="https://www.ifranchising.cz/osobni-udaje.php">Zásady ochrany osobních údajů</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('hlavni-menu');
      btn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
